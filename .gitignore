node_modules/
playwright/test-results/

# Keep the html-report folders (via .gitkeep) but ignore their generated contents
playwright/projects/*/html-report/*
!playwright/projects/*/html-report/.gitkeep

# Auth storage-state files hold live session tokens. Keep them empty ({}) locally;
# they are regenerated by auth.setup at runtime and must never be committed.
playwright/projects/*/tests/.auth/*.json
!playwright/projects/*/tests/.auth/.gitkeep

